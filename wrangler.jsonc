{
	"name": "portfolio",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-10-12",
	// the Worker answers for the whole domain; its DNS record stays as it is
	"routes": [
		{ "pattern": "adrien-segalat.fr/*", "zone_name": "adrien-segalat.fr" }
	],
	"assets": {
		"directory": "./frontend/dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"send_email": [{ "name": "EMAIL" }],
	"vars": {
		"CONTACT_FROM_NAME": "Portfolio Contact"
	},
	// same as the dashboard's Observability settings, so a deploy keeps them
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		}
	}
}
